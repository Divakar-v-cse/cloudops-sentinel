# ============================================================================
# CloudOps Sentinel - example environment
# Copy to .env and replace every value marked CHANGE_ME. Never commit .env.
# ============================================================================

# --- core -------------------------------------------------------------------
ENVIRONMENT=local
SECRET_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32
DEBUG=false

# --- database ---------------------------------------------------------------
# Local mode default (SQLite, no server required):
DATABASE_URL=sqlite:///./cloudops.db
# PostgreSQL (docker compose / production):
# DATABASE_URL=postgresql+psycopg://sentinel:CHANGE_ME@localhost:5432/cloudops
POSTGRES_DB=cloudops
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
REDIS_URL=

# --- bootstrap admin (change immediately after first login) ------------------
DEFAULT_ADMIN_EMAIL=admin@cloudops.local
DEFAULT_ADMIN_PASSWORD=CHANGE_ME_admin_password
DEFAULT_ANALYST_PASSWORD=CHANGE_ME_analyst_password

# --- monitoring -------------------------------------------------------------
ENABLE_SCHEDULER=true
ENABLE_LOCAL_COLLECTOR=true
MONITORING_INTERVAL_SECONDS=15
MONITORING_HISTORY_RETENTION_HOURS=72
CPU_WARNING=70
CPU_CRITICAL=90
MEMORY_WARNING=75
MEMORY_CRITICAL=92
DISK_WARNING=80
DISK_CRITICAL=93

# --- AWS (optional, read-only) ----------------------------------------------
# Keep simulation on until you have a read-only role attached and verified.
AWS_SIMULATION_MODE=true
AWS_REGION=us-east-1
AWS_PROFILE=
# Prefer an instance role. If you must use keys, export them in the shell only:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
SNS_TOPIC_ARN=

# --- cost model -------------------------------------------------------------
COST_BUDGET_USD=3000
COST_HOURS_PER_MONTH=730

# --- logs -------------------------------------------------------------------
LOG_RETENTION_DAYS=14

# --- optional AI log explanation (never required) ---------------------------
AI_PROVIDER=none
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# --- frontend / cors --------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1
BACKEND_PORT=8000
FRONTEND_PORT=8080
